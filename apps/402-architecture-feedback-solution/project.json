{
  "name": "402-architecture-feedback-solution",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "wm",
  "sourceRoot": "apps/402-architecture-feedback-solution/src",
  "tags": ["type:app"],
  "implicitDependencies": ["402-architecture-feedback-solution-*"],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/{projectRoot}",
        "browser": "{projectRoot}/src/main.ts",
        "tsConfig": "{projectRoot}/tsconfig.app.json",
        "assets": [
          {
            "glob": "**/*",
            "input": "{projectRoot}/public"
          }
        ],
        "styles": [
          "{projectRoot}/src/material-theme.scss",
          "{projectRoot}/src/styles.css"
        ]
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "8kb"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      }
    },
    "serve": {
      "continuous": true,
      "executor": "@angular/build:dev-server",
      "defaultConfiguration": "development",
      "configurations": {
        "production": {
          "buildTarget": "402-architecture-feedback-solution:build:production"
        },
        "development": {
          "buildTarget": "402-architecture-feedback-solution:build:development"
        }
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "402-architecture-feedback-solution:build",
        "staticFilePath": "dist/{projectRoot}/browser",
        "spa": true
      }
    }
  }
}
