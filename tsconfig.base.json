{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "strict": false,
    "paths": {
      "@whiskmate/meal-plan/domain": ["./libs/meal-plan/domain/index.ts"],
      "@whiskmate/meal-plan/feature": ["./libs/meal-plan/feature/index.ts"],
      "@whiskmate/meal-plan/infra": ["./libs/meal-plan/infra/index.ts"],
      "@whiskmate/meal-plan/model": ["./libs/meal-plan/model/index.ts"],
      "@whiskmate/meal-plan/recipe-picker-feature": [
        "./libs/meal-plan/recipe-picker-feature/index.ts"
      ],
      "@whiskmate/meal-plan/ui": ["./libs/meal-plan/ui/index.ts"],
      "@whiskmate/recipe/domain": ["./libs/recipe/domain/index.ts"],
      "@whiskmate/recipe/infra": ["./libs/recipe/infra/index.ts"],
      "@whiskmate/recipe/model": ["./libs/recipe/model/index.ts"],
      "@whiskmate/recipe/search-feature": [
        "./libs/recipe/search-feature/index.ts"
      ],
      "@whiskmate/recipe/search-ui": ["./libs/recipe/search-ui/index.ts"],
      "@whiskmate/shared/infra": ["./libs/shared/infra/index.ts"],
      "@whiskmate/shared/model": ["./libs/shared/model/index.ts"],
      "@whiskmate/shared/ui": ["./libs/shared/ui/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
