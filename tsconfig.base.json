{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "strict": false,
    "paths": {
      "@whiskmate/meal-plan/feature-meal-plan": [
        "./libs/meal-plan/feature-meal-plan/index.ts"
      ],
      "@whiskmate/meal-plan/ui": ["./libs/meal-plan/ui/index.ts"],
      "@whiskmate/recipe/domain": ["./libs/recipe/domain/index.ts"],
      "@whiskmate/recipe/feature-recipe-picker": [
        "./libs/recipe/feature-recipe-picker/index.ts"
      ],
      "@whiskmate/recipe/infra": ["./libs/recipe/infra/index.ts"],
      "@whiskmate/recipe/feature-search": [
        "./libs/recipe/feature-search/index.ts"
      ],
      "@whiskmate/shared-meal-plan/domain": [
        "./libs/shared-meal-plan/domain/index.ts"
      ],
      "@whiskmate/shared-meal-plan/infra": [
        "./libs/shared-meal-plan/infra/index.ts"
      ],
      "@whiskmate/shared-meal-plan/model": [
        "./libs/shared-meal-plan/model/index.ts"
      ],
      "@whiskmate/shared-recipe/model": ["./libs/shared-recipe/model/index.ts"],
      "@whiskmate/shared-recipe/infra": [
        "./libs/shared-recipe/infra/index.ts"
      ],
      "@whiskmate/recipe/ui-search": ["./libs/recipe/ui-search/index.ts"],
      "@whiskmate/shared/infra": ["./libs/shared/infra/index.ts"],
      "@whiskmate/shared/model": ["./libs/shared/model/index.ts"],
      "@whiskmate/shared/ui": ["./libs/shared/ui/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
