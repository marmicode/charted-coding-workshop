      ],
      "@whiskmate/authz/model": [
        "./apps/whiskmate/src/app/authz/model/index.ts"
      ],
      "@whiskmate/meal-plan/feature-meal-plan": [
        "./apps/whiskmate/src/app/meal-plan/feature-meal-plan/index.ts"
      ],
      "@whiskmate/meal-plan/ui": [
        "./apps/whiskmate/src/app/meal-plan/ui/index.ts"
      ],
      "@whiskmate/recipe/domain": [
        "./apps/whiskmate/src/app/recipe/domain/index.ts"
      ],
      "@whiskmate/recipe/feature-search": [
        "./apps/whiskmate/src/app/recipe/feature-search/index.ts"
      ],
      "@whiskmate/recipe/infra": [
        "./apps/whiskmate/src/app/recipe/infra/index.ts"
      ],
