        "./apps/whiskmate/src/app/recipe/model/index.ts"
      ],
      "@whiskmate/recipe/ui": [
        "./apps/whiskmate/src/app/recipe/ui/index.ts"
      ],
      "@whiskmate/recipe/ui-search": [
        "./apps/whiskmate/src/app/recipe/ui-search/index.ts"
      ],
      "@whiskmate/shared-meal-plan/domain": [
        "./apps/whiskmate/src/app/shared-meal-plan/domain/index.ts"
      ],
      "@whiskmate/shared-recipe/model": [
        "./apps/whiskmate/src/app/shared-recipe/model/index.ts"
      ],
      "@whiskmate/shared/infra": [
        "./apps/whiskmate/src/app/shared/infra/index.ts"
      ],
      "@whiskmate/shared/model": [
        "./apps/whiskmate/src/app/shared/model/index.ts"
